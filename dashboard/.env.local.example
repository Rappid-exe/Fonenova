# Copy this file to .env.local (same folder) and fill in your paths. .env.local is never committed.

# The order ledger, where OneDrive keeps it. The dashboard re-imports it whenever you save it.
FN_LEDGER_PATH=C:\Users\fonen\OneDrive\Desktop\FoneNova_Order_Ledger.xlsx

# The folder holding the VAT return tracker. The newest "VAT Return From....xlsx" is used;
# anything in a _backups folder is skipped.
FN_EXPENSES_DIR=C:\Users\fonen\OneDrive\Desktop\VAT RETURNS

# Xero (read-only), once you have created the Xero app. See README.
# XERO_CLIENT_ID=
